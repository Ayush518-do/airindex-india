# Brevo (Sendinblue) transactional email API key — used by pipeline/notifier.py
# for low-fare alerts. Leave blank to disable email sending (alerts are still
# logged). Never commit the real .env file.
BREVO_API_KEY=

# Optional: sender identity for alert emails
ALERT_FROM_EMAIL=alerts@airindex.local
ALERT_FROM_NAME=AIRINDEX INDIA

# Optional: comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode. Off by default. When set to 1 the whole app reads a SEPARATE
# database (data/processed/airindex_demo.db) built by scripts/build_demo_db.py,
# containing seeded fare history for presentations. The live store is never
# touched, and the UI shows a "DEMO DATA" badge. Real mode never mixes it in.
DEMO_MODE=0
